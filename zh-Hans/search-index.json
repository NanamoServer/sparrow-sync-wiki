ion":[[1,2]]},"53":{"position":[[1,2]]},"55":{"position":[[1,2]]},"57":{"position":[[1,2]]},"59":{"position":[[1,2]]},"61":{"position":[[1,2]]},"63":{"position":[[1,2]]}}}],["本",{"_index":5,"t":{"45":{"position":[[0,1]]},"47":{"position":[[0,1]]},"49":{"position":[[0,1]]},"51":{"position":[[0,1]]},"53":{"position":[[0,1]]},"55":{"position":[[0,1]]},"57":{"position":[[0,1]]},"59":{"position":[[0,1]]},"61":{"position":[[0,1]]},"63":{"position":[[0,1]]}}}],["欢迎",{"_index":0,"t":{"33":{"position":[[0,2]]}}}],["编写",{"_index":6,"t":{"45":{"position":[[3,2]]},"47":{"position":[[3,2]]},"49":{"position":[[3,2]]},"51":{"position":[[3,2]]},"53":{"position":[[3,2]]},"55":{"position":[[3,2]]},"57":{"position":[[3,2]]},"59":{"position":[[3,2]]},"61":{"position":[[3,2]]},"63":{"position":[[3,2]]}}}],["阅读",{"_index":1,"t":{"33":{"position":[[2,2]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":34,"t":"欢迎阅读 Sparrow Sync 文档！🐦","s":"📗 介绍","u":"/sparrow-sync-wiki/zh-Hans/","h":"","p":33},{"i":36,"t":"Sparrow Sync 是一款用于跨服务器同步玩家数据的 Paper / Folia 插件。它通过 Redis 协调玩家会话，并将玩家数据保存为持久化快照——玩家在不同服务器之间切换时进度不丢失，管理员也可以随时恢复历史存档。 信息 Sparrow Sync 在对应的服务器线程上采集玩家状态（完全兼容 Folia），再异步编码并保存快照。同一玩家的任务始终按顺序处理，网络波动也不会导致数据乱序写入。","s":"什么是 Sparrow Sync","u":"/sparrow-sync-wiki/zh-Hans/","h":"#什么是-sparrow-sync","p":33},{"i":38,"t":"背包、末影箱、经验、生命值、饥饿值、药水效果、进度、统计、属性、位置等——每种数据类型都可以在配置中单独开关。地图数据也可以在服务器之间共享，同步模式与交互限制均可配置。","s":"可以同步哪些数据","u":"/sparrow-sync-wiki/zh-Hans/","h":"#可以同步哪些数据","p":33},{"i":40,"t":"🗄️ 多种存储后端——MongoDB、MySQL 或 PostgreSQL 持久化数据，Redis 协调跨服操作 📦 快照压缩——使用 Sparrow NBT 保存玩家数据，支持 Zstd、Deflate 和不压缩三种格式 🖥️ 快照管理菜单——在游戏内浏览快照、查看内容、恢复历史数据、固定记录和导出快照 🗺️ 地图同步——在服务器之间共享地图数据，同步模式与交互限制均可配置 🔧 数据恢复工具——查看本地异常档案，通过快照导入、导出和批量归档命令管理数据 🔄 数据迁移——一条命令即可从 HuskSync 或 InvSync 迁移现有数据","s":"核心功能","u":"/sparrow-sync-wiki/zh-Hans/","h":"#核心功能","p":33},{"i":42,"t":"在每台参与同步的 Paper 或 Folia 服务器上安装插件，配置共用的 Redis 服务和数据库，并在每台服务器的 server.yml 中设置互不相同的 server-id。 → GitHub 上的完整安装指南 提示 文档仍在编写中。在配置参考迁移到本站之前，安装步骤、配置文件说明和命令列表请以 GitHub README 为准。","s":"快速开始","u":"/sparrow-sync-wiki/zh-Hans/","h":"#快速开始","p":33},{"i":44,"t":"遇到 Bug 或有功能建议？欢迎在 GitHub 提交 Issue 项目以 GPL v3 协议开源——欢迎贡献代码与翻译","s":"获取帮助","u":"/sparrow-sync-wiki/zh-Hans/","h":"#获取帮助","p":33},{"i":46,"t":"本文档编写中。","s":"📤 数据导出","u":"/sparrow-sync-wiki/zh-Hans/advanced/data-export","h":"","p":45},{"i":48,"t":"本文档编写中。","s":"🧰 异常数据处理","u":"/sparrow-sync-wiki/zh-Hans/advanced/exception-data","h":"","p":47},{"i":50,"t":"本文档编写中。","s":"🗺️ 地图同步","u":"/sparrow-sync-wiki/zh-Hans/advanced/map-sync","h":"","p":49},{"i":52,"t":"本文档编写中。","s":"📘 基础 API 使用","u":"/sparrow-sync-wiki/zh-Hans/api/basic-usage","h":"","p":51},{"i":54,"t":"本文档编写中。","s":"🤝 数据委托","u":"/sparrow-sync-wiki/zh-Hans/api/data-delegation","h":"","p":53},{"i":56,"t":"本文档编写中。","s":"🗂️ 数据文件格式","u":"/sparrow-sync-wiki/zh-Hans/api/data-file-format","h":"","p":55},{"i":58,"t":"本文档编写中。","s":"🔑 权限命令","u":"/sparrow-sync-wiki/zh-Hans/getting-started/commands","h":"","p":57},{"i":60,"t":"本文档编写中。","s":"⚙️ 配置文件","u":"/sparrow-sync-wiki/zh-Hans/getting-started/configuration","h":"","p":59},{"i":62,"t":"本文档编写中。","s":"📦 安装插件","u":"/sparrow-sync-wiki/zh-Hans/getting-started/installation","h":"","p":61},{"i":64,"t":"本文档编写中。","s":"🔄 数据迁移","u":"/sparrow-sync-wiki/zh-Hans/getting-started/migration","h":"","p":63}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/34",[0,2.724,1,3.45,2,2.246,3,2.724,4,0.437]],["t/36",[2,1.225,3,1.486,5,1.142,6,1.142,7,0.902,8,1.486,9,0.625,10,2.615,11,1.562,12,0.902,13,1.486,14,0.902,15,0.902,16,0.743,17,0.902,18,1.142,19,1.142,20,1.142,21,1.486,22,0.902,23,0.902,24,1.486,25,1.142,26,0.743,27,1.142,28,1.142,29,0.902,30,1.142,31,1.142,32,0.902,33,1.142,34,0.902,35,1.142,36,1.142,37,1.142,38,1.142,39,1.142,40,1.142,41,1.142,42,1.142,43,1.142,44,1.142,45,1.142,46,1.142,47,1.142,48,1.142,49,1.142,50,1.142,51,1.142,52,1.142,53,1.142,54,1.142,55,1.142,56,1.142,57,1.14