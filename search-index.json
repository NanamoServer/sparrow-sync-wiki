tion":[[19,5]]},"21":{"position":[[19,5]]},"23":{"position":[[19,5]]},"25":{"position":[[19,5]]},"27":{"position":[[19,5]]},"29":{"position":[[19,5]]},"31":{"position":[[19,5]]}}}],["doc",{"_index":4,"t":{"1":{"position":[[39,4]]}}}],["hey",{"_index":0,"t":{"1":{"position":[[0,3]]}}}],["page",{"_index":5,"t":{"13":{"position":[[5,4]]},"15":{"position":[[5,4]]},"17":{"position":[[5,4]]},"19":{"position":[[5,4]]},"21":{"position":[[5,4]]},"23":{"position":[[5,4]]},"25":{"position":[[5,4]]},"27":{"position":[[5,4]]},"29":{"position":[[5,4]]},"31":{"position":[[5,4]]}}}],["sparrow",{"_index":2,"t":{"1":{"position":[[26,7]]}}}],["still",{"_index":6,"t":{"13":{"position":[[13,5]]},"15":{"position":[[13,5]]},"17":{"position":[[13,5]]},"19":{"position":[[13,5]]},"21":{"position":[[13,5]]},"23":{"position":[[13,5]]},"25":{"position":[[13,5]]},"27":{"position":[[13,5]]},"29":{"position":[[13,5]]},"31":{"position":[[13,5]]}}}],["sync",{"_index":3,"t":{"1":{"position":[[34,4]]}}}],["welcom",{"_index":1,"t":{"1":{"position":[[11,7]]}}}],["written",{"_index":8,"t":{"13":{"position":[[25,7]]},"15":{"position":[[25,7]]},"17":{"position":[[25,7]]},"19":{"position":[[25,7]]},"21":{"position":[[25,7]]},"23":{"position":[[25,7]]},"25":{"position":[[25,7]]},"27":{"position":[[25,7]]},"29":{"position":[[25,7]]},"31":{"position":[[25,7]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":2,"t":"Hey there! Welcome to the Sparrow Sync docs! 🐦","s":"📗 Introduction","u":"/sparrow-sync-wiki/","h":"","p":1},{"i":4,"t":"Sparrow Sync is a Paper and Folia plugin for synchronizing player data across Minecraft servers. It coordinates player sessions through Redis and stores player data as persistent snapshots, so players keep their progress when they move between servers — and administrators can recover earlier saves at any time. info Sparrow Sync captures player state on the appropriate server thread (fully Folia-compatible), then encodes and stores snapshots asynchronously. Tasks for the same player are always processed in order, so a busy network never writes data out of sequence.","s":"What is Sparrow Sync","u":"/sparrow-sync-wiki/","h":"#what-is-sparrow-sync","p":1},{"i":6,"t":"Inventories, ender chests, experience, health, hunger, potion effects, advancements, statistics, attributes, location and more — every data type can be toggled individually in the configuration. Map data can also be shared between servers, with configurable synchronization modes and interaction controls.","s":"What can be synchronized","u":"/sparrow-sync-wiki/","h":"#what-can-be-synchronized","p":1},{"i":8,"t":"🗄️ Flexible storage — MongoDB, MySQL or PostgreSQL for persistence, with Redis handling cross-server coordination 📦 Compressed snapshots — player data stored with Sparrow NBT, in Zstd, Deflate or uncompressed form 🖥️ Snapshot management GUI — browse saved snapshots, inspect their contents, restore earlier data, pin records and export snapshots through an in-game menu 🗺️ Map synchronization — share map data between servers, with configurable sync modes and interaction controls 🔧 Recovery tools — inspect local exception archives and manage data with snapshot import, export and bulk archive commands 🔄 Migration — move existing data over from HuskSync or InvSync with a single command","s":"Key features","u":"/sparrow-sync-wiki/","h":"#key-features","p":1},{"i":10,"t":"Install the plugin on every participating Paper or Folia server, point them at a shared Redis service and database, and give each server a unique server-id in server.yml. → Full setup guide on GitHub tip The documentation is still being written. Until the configuration reference lands here, the GitHub README covers installation, configuration files and commands.","s":"Quick start","u":"/sparrow-sync-wiki/","h":"#quick-start","p":1},{"i":12,"t":"Found a bug or have a feature request? Open an issue on GitHub The full source is available under the GPL v3 license — contributions are welcome, translations included","s":"Getting help","u":"/sparrow-sync-wiki/","h":"#getting-help","p":1},{"i":14,"t":"This page is still being written.","s":"📤 Data Export","u":"/sparrow-sync-wiki/advanced/data-export","h":"","p":13},{"i":16,"t":"This page is still being written.","s":"🧰 Exception Data Handling","u":"/sparrow-sync-wiki/advanced/exception-data","h":"","p":15},{"i":18,"t":"This page is still being written.","s":"🗺️ Map Synchronization","u":"/sparrow-sync-wiki/advanced/map-sync","h":"","p":17},{"i":20,"t":"This page is still being written.","s":"📘 Basic API Usage","u":"/sparrow-sync-wiki/api/basic-usage","h":"","p":19},{"i":22,"t":"This page is still being written.","s":"🤝 Data Delegation","u":"/sparrow-sync-wiki/api/data-delegation","h":"","p":21},{"i":24,"t":"This page is still being written.","s":"🗂️ Data File Format","u":"/sparrow-sync-wiki/api/data-file-format","h":"","p":23},{"i":26,"t":"This page is still being written.","s":"🔑 Permissions & Commands","u":"/sparrow-sync-wiki/getting-started/commands","h":"","p":25},{"i":28,"t":"This page is still being written.","s":"⚙️ Configuration Files","u":"/sparrow-sync-wiki/getting-started/configuration","h":"","p":27},{"i":30,"t":"This page is still being written.","s":"📦 Installation","u":"/sparrow-sync-wiki/getting-started/installation","h":"","p":29},{"i":32,"t":"This page is still being written.","s":"🔄 Data Migration","u":"/sparrow-sync-wiki/getting-started/migration","h":"","p":31}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,3.4,1,2.685,2,2.214,3,2.214,4,3.4]],["t/4",[2,1.253,3,1.253,5,0.927,6,1.52,7,0.927,8,0.764,9,2.65,10,1.593,11,1.174,12,1.34,13,0.927,14,1.174,15,0.927,16,0.764,17,1.52,18,0.927,19,1.52,20,1.174,21,1.174,22,0.927,23,0.764,24,1.174,25,1.174,26,0.927,27,0.927,28,1.174,29,1.174,30,1.174,31,1.174,32,1.174,33,1.174,34,1.174,35,1.174,36,1.174,37,1.174,38,1.174,39,1.174,40,1.174,41